# ==========================================================================
# FullBoost Race Parts — variáveis de ambiente
# Copie para `.env` e ajuste. NUNCA versione o .env real.
# Produção: veja docs/DEPLOY.md (o servidor RECUSA subir com valores de exemplo).
# ==========================================================================

# --- Banco de dados -------------------------------------------------------
# Dev/demo: SQLite local (zero configuração). connection_limit=1 evita
# travamento do SQLite com compras simultâneas.
DATABASE_URL="file:./dev.db?connection_limit=1"
# Produção (Supabase/Postgres) — usa prisma/postgres/schema.prisma:
# DATABASE_URL="postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Autenticação do painel ------------------------------------------------
# Produção: 32+ caracteres aleatórios →  openssl rand -base64 48
AUTH_SECRET="troque-este-segredo-em-producao"

# --- Loja -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# WhatsApp de vendas: 55 + DDD + número, só dígitos (ex.: 5547999999999)
NEXT_PUBLIC_WHATSAPP="5500000000000"

# Contatos exibidos no site — OPCIONAIS (vazio = o bloco não aparece)
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_BUSINESS_HOURS=""
NEXT_PUBLIC_ADDRESS=""
NEXT_PUBLIC_PRIVACY_EMAIL=""
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/fullboostraceparts"
NEXT_PUBLIC_INSTAGRAM_HANDLE="@fullboostraceparts"
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""

# Identificação do vendedor (Decreto 7.962/2013: nome + CPF ou CNPJ na loja).
# Opcional na fase modelo; obrigatório para vender de verdade.
NEXT_PUBLIC_LEGAL_NAME=""
NEXT_PUBLIC_LEGAL_DOCUMENT=""

# Regras comerciais anunciadas (uma fonte p/ vitrine, carrinho e servidor)
NEXT_PUBLIC_FREE_SHIPPING_FROM="599"   # 0 = sem frete grátis
NEXT_PUBLIC_FLAT_SHIPPING="34.9"
NEXT_PUBLIC_MAX_INSTALLMENTS="10"      # 1 = não anuncia parcelamento

# --- Fotos (produção na Vercel: obrigatório Supabase Storage) --------------
# STORAGE_DRIVER="supabase"
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""          # só no servidor, nunca NEXT_PUBLIC
# SUPABASE_STORAGE_BUCKET="media"       # bucket PÚBLICO

# --- E-mail transacional (opcional — Resend) -------------------------------
# RESEND_API_KEY=""
# EMAIL_FROM="FullBoost <pedidos@seudominio.com.br>"
# STORE_NOTIFY_EMAIL="voce@seudominio.com.br"   # recebe aviso de pedido/contato

# --- Cron de expiração de reservas (Vercel envia Bearer automaticamente) ---
# CRON_SECRET=""

# --- Bootstrap do 1º admin em produção (npm run db:bootstrap) --------------
# BOOTSTRAP_ADMIN_EMAIL=""
# BOOTSTRAP_ADMIN_NAME=""
# BOOTSTRAP_ADMIN_PASSWORD=""           # remova depois de usar
