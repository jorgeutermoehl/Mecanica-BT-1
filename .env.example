# ==========================================================================
# FullBoost Race Parts — variáveis de ambiente
# Copie para `.env` e ajuste. NUNCA versione o .env real.
# (Este arquivo é referenciado no README — necessário para rodar o projeto.)
# ==========================================================================

# --- Banco de dados (PostgreSQL) -------------------------------------------
# Local: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=pg -e POSTGRES_DB=fullboost postgres:16
DATABASE_URL="postgresql://postgres:pg@localhost:5432/fullboost"
DIRECT_URL="postgresql://postgres:pg@localhost:5432/fullboost"
# Produção (Supabase): DATABASE_URL = pooler transaction (porta 6543) com
#   ?pgbouncer=true&connection_limit=1 ; DIRECT_URL = conexão direta/session (5432).

# --- Storage de mídia -------------------------------------------------------
# Local: grava em ./uploads. Produção (Vercel): STORAGE_DRIVER=supabase.
# STORAGE_DRIVER="supabase"
# SUPABASE_URL="https://<projeto>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""   # server-only, NUNCA NEXT_PUBLIC_
# SUPABASE_STORAGE_BUCKET="media" # bucket PRIVADO

# --- Cron / pagamentos --------------------------------------------------------
# CRON_SECRET (Vercel envia como Bearer ao chamar /api/cron/*). Gere: openssl rand -hex 32
# CRON_SECRET=""
# MP_ACCESS_TOKEN=""
# MP_WEBHOOK_SECRET=""

# --- Autenticação do painel ------------------------------------------------
# Segredo que assina os tokens de sessão. OBRIGATÓRIO trocar em produção.
AUTH_SECRET="troque-este-segredo-em-producao"

# --- Aplicação --------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# WhatsApp no formato internacional, só dígitos (ex.: 5547999999999)
NEXT_PUBLIC_WHATSAPP="5500000000000"
