# ==========================================================================
# Diógenes Auto Peças — variáveis de ambiente
# Copie para `.env` (e `.env.local`) e preencha. NUNCA versione o .env real.
# ==========================================================================

# --- Banco de dados (Supabase / PostgreSQL) -------------------------------
# Connection string COM pgbouncer (porta 6543) — usada pela aplicação/Prisma Client.
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão DIRETA (porta 5432) — usada por `prisma migrate`.
DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"

# --- Supabase Auth / Storage ----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"
# Somente no servidor — NUNCA exponha no client.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- Aplicação ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Número do WhatsApp no formato internacional, só dígitos (ex.: 5547999999999)
NEXT_PUBLIC_WHATSAPP="5500000000000"
