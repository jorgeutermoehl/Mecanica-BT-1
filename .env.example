# ==========================================================================
# FullBoost Race Parts — variáveis de ambiente
# Copie para `.env` e ajuste. NUNCA versione o .env real.
# (Este arquivo é referenciado no README — necessário para rodar o projeto.)
# ==========================================================================

# --- Banco de dados -------------------------------------------------------
# Dev/demo: SQLite local (zero configuração).
DATABASE_URL="file:./dev.db"
# Produção (Supabase/Postgres): troque o provider no schema.prisma e use:
# DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?pgbouncer=true"

# --- Autenticação do painel ------------------------------------------------
# Segredo que assina os tokens de sessão. OBRIGATÓRIO trocar em produção.
AUTH_SECRET="troque-este-segredo-em-producao"

# --- Aplicação --------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# WhatsApp no formato internacional, só dígitos (ex.: 5547999999999)
NEXT_PUBLIC_WHATSAPP="5500000000000"
