// FullBoost Race Parts — schema do banco (SQLite em dev/demo; Postgres/Supabase em produção)
//
// NOTA SQLite: enums e Json nativos não são suportados — campos de status/tipo
// usam String com valores validados por Zod em `src/lib/validations.ts`
// (mesmos literais dos enums originais, ex.: "ACTIVE", "SALE", "PIX").
// Para voltar ao Postgres: trocar provider, restaurar enums e @db.Decimal.
//
// Invariantes:
//  - InventoryMovement e AuditLog são APPEND-ONLY (correção = novo lançamento).
//  - OrderItem.unitCostAtSale CONGELA o custo no momento da venda (DRE/CMV corretos).
//  - Soft-delete (deletedAt / status) em dados críticos — sem exclusão física.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// ACESSO / PERMISSÕES
// ===========================================================================

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  description String?
  permissions Permission[] @relation("RolePermissions")
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // ex.: "products.create"
  description String?
  roles       Role[]   @relation("RolePermissions")
  createdAt   DateTime @default(now())
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  name         String
  phone        String?
  /// Hash bcrypt da senha (login local do painel).
  passwordHash String?
  isActive     Boolean @default(true)
  roleId       String?
  role         Role?   @relation(fields: [roleId], references: [id])

  customer        Customer?
  movements       InventoryMovement[]
  stockEntries    StockEntry[]
  orders          Order[] // como vendedor responsável
  auditLogs       AuditLog[]
  contactMessages ContactMessage[]    @relation("ContactHandler")
  cashFlowEntries CashFlowEntry[]
  cookieConsents  CookieConsent[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([roleId])
}

// ===========================================================================
// PESSOAS
// ===========================================================================

model Customer {
  id                String              @id @default(cuid())
  userId            String?             @unique
  user              User?               @relation(fields: [userId], references: [id])
  name              String
  document          String? // CPF/CNPJ
  personType        String              @default("INDIVIDUAL") // INDIVIDUAL | COMPANY
  email             String?
  phone             String?
  notes             String?
  totalSpent        Decimal             @default(0)
  lastPurchaseAt    DateTime?
  addresses         Address[]
  orders            Order[]
  receivables       AccountReceivable[]
  couponRedemptions CouponRedemption[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  @@index([document])
  @@index([email])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  zipCode    String
  street     String
  number     String?
  complement String?
  district   String?
  city       String
  state      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model Supplier {
  id           String           @id @default(cuid())
  legalName    String
  tradeName    String?
  document     String? // CNPJ/CPF
  personType   String           @default("COMPANY") // INDIVIDUAL | COMPANY
  email        String?
  phone        String?
  zipCode      String?
  street       String?
  number       String?
  complement   String?
  district     String?
  city         String?
  state        String?
  paymentTerms String?
  notes        String?
  stockEntries StockEntry[]
  payables     AccountPayable[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  @@index([document])
}

// ===========================================================================
// CATÁLOGO
// ===========================================================================

model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  imageUrl    String?
  /// Chave do ícone exibido na loja (turbo, motor, freios, rodas...).
  icon        String?
  /// Categoria destacada na home (ex.: Rodas).
  featured    Boolean     @default(false)
  position    Int         @default(0)
  parentId    String?
  parent      Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryTree")
  products    Product[]
  promotions  Promotion[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Manufacturer {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id             String        @id @default(cuid())
  sku            String        @unique
  name           String
  slug           String        @unique
  internalCode   String?
  originalCode   String? // código original/fabricante
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  brandId        String?
  brand          Brand?        @relation(fields: [brandId], references: [id])
  manufacturerId String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])
  description    String?
  technicalSpecs String?
  /// Compatibilidade resumida exibida no card (ex.: "Golf GTI Mk7").
  fitment        String?
  costPrice      Decimal       @default(0) // custo médio atual
  salePrice      Decimal       @default(0)
  promoPrice     Decimal?
  desiredMargin  Decimal? // %
  stockQuantity  Int           @default(0)
  minStock       Int           @default(0)
  location       String?
  weightGrams    Int?
  widthCm        Decimal?
  heightCm       Decimal?
  lengthCm       Decimal?
  warranty       String?
  status         String        @default("ACTIVE") // ACTIVE | INACTIVE | OUT_OF_STOCK | PROMOTION
  internalNotes  String?

  images          ProductImage[]
  applications    ProductApplication[]
  orderItems      OrderItem[]
  movements       InventoryMovement[]
  stockEntryItems StockEntryItem[]
  promotions      Promotion[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([name])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId])
}

/// Compatibilidade da peça com veículos (marca/modelo/ano/motor).
model ProductApplication {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleBrand String
  vehicleModel String
  yearStart    Int?
  yearEnd      Int?
  engine       String?
  notes        String?

  @@index([productId])
  @@index([vehicleBrand, vehicleModel])
}

// ===========================================================================
// ESTOQUE
// ===========================================================================

/// Livro-razão de estoque (APPEND-ONLY). Saldo é derivado dos lançamentos.
model InventoryMovement {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  /// ENTRY | SALE | MANUAL_OUT | ADJUSTMENT | CUSTOMER_RETURN | SUPPLIER_RETURN | LOSS | INVENTORY
  type          String
  direction     String // IN | OUT
  quantity      Int
  unitCost      Decimal     @default(0)
  balanceBefore Int
  balanceAfter  Int
  reason        String?
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  orderId       String?
  order         Order?      @relation(fields: [orderId], references: [id])
  stockEntryId  String?
  stockEntry    StockEntry? @relation(fields: [stockEntryId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model StockEntry {
  id              String              @id @default(cuid())
  supplierId      String?
  supplier        Supplier?           @relation(fields: [supplierId], references: [id])
  invoiceNumber   String?
  purchaseDate    DateTime?
  entryDate       DateTime            @default(now())
  freight         Decimal             @default(0)
  otherExpenses   Decimal             @default(0)
  taxes           Decimal             @default(0)
  itemsTotal      Decimal             @default(0)
  total           Decimal             @default(0)
  paymentMethod   String? // PIX | CREDIT_CARD | DEBIT_CARD | BOLETO | CASH | BANK_TRANSFER
  installments    Int                 @default(1)
  financialStatus String              @default("OPEN") // OPEN | PAID | PARTIAL | OVERDUE | CANCELLED
  notes           String?
  userId          String?
  user            User?               @relation(fields: [userId], references: [id])
  items           StockEntryItem[]
  movements       InventoryMovement[]
  payables        AccountPayable[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([supplierId])
  @@index([entryDate])
}

model StockEntryItem {
  id           String     @id @default(cuid())
  stockEntryId String
  stockEntry   StockEntry @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int
  unitCost     Decimal
  totalCost    Decimal

  @@index([stockEntryId])
  @@index([productId])
}

// ===========================================================================
// VENDAS / PEDIDOS
// ===========================================================================

model Order {
  id               String    @id @default(cuid())
  number           String    @unique
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id])
  customerName     String // snapshot
  customerDocument String?
  customerEmail    String?
  customerPhone    String?
  /// AWAITING_PAYMENT | PAID | SEPARATING | SHIPPED | DELIVERED | CANCELLED | RETURNED
  status           String    @default("AWAITING_PAYMENT")
  /// Canal da venda: SITE | INSTAGRAM | WHATSAPP | LOJA
  channel          String    @default("SITE")
  subtotal         Decimal   @default(0)
  discount         Decimal   @default(0)
  shippingCost     Decimal   @default(0)
  total            Decimal   @default(0)
  couponId         String?
  coupon           Coupon?   @relation(fields: [couponId], references: [id])
  couponCode       String?
  paymentMethod    String? // PIX | CREDIT_CARD | DEBIT_CARD | BOLETO | CASH | BANK_TRANSFER

  // Snapshot do endereço de entrega
  shipZipCode    String?
  shipStreet     String?
  shipNumber     String?
  shipComplement String?
  shipDistrict   String?
  shipCity       String?
  shipState      String?

  notes  String?
  userId String? // vendedor responsável
  user   User?   @relation(fields: [userId], references: [id])

  items             OrderItem[]
  payments          Payment[]
  movements         InventoryMovement[]
  receivables       AccountReceivable[]
  statusHistory     OrderStatusHistory[]
  couponRedemptions CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  productName    String // snapshot
  sku            String // snapshot
  quantity       Int
  unitPrice      Decimal
  unitCostAtSale Decimal // CUSTO CONGELADO p/ DRE
  discount       Decimal  @default(0)
  total          Decimal

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Payment {
  id                String    @id @default(cuid())
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount            Decimal
  method            String // PIX | CREDIT_CARD | DEBIT_CARD | BOLETO | CASH | BANK_TRANSFER
  status            String    @default("PENDING") // PENDING | PAID | PARTIAL | OVERDUE | CANCELLED | REFUNDED
  installmentNumber Int       @default(1)
  paidAt            DateTime?
  dueDate           DateTime?
  createdAt         DateTime  @default(now())

  @@index([orderId])
}

// ===========================================================================
// FINANCEIRO
// ===========================================================================

model AccountPayable {
  id            String      @id @default(cuid())
  supplierId    String?
  supplier      Supplier?   @relation(fields: [supplierId], references: [id])
  stockEntryId  String?
  stockEntry    StockEntry? @relation(fields: [stockEntryId], references: [id])
  description   String
  category      String?
  amount        Decimal
  paidAmount    Decimal     @default(0)
  dueDate       DateTime
  paidAt        DateTime?
  status        String      @default("OPEN") // OPEN | PAID | PARTIAL | OVERDUE | CANCELLED
  paymentMethod String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([dueDate])
}

model AccountReceivable {
  id             String    @id @default(cuid())
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  orderId        String?
  order          Order?    @relation(fields: [orderId], references: [id])
  description    String
  amount         Decimal
  receivedAmount Decimal   @default(0)
  dueDate        DateTime
  receivedAt     DateTime?
  status         String    @default("OPEN") // OPEN | PAID | PARTIAL | OVERDUE | CANCELLED
  paymentMethod  String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([dueDate])
}

model CashFlowEntry {
  id           String   @id @default(cuid())
  type         String // INFLOW | OUTFLOW
  category     String?
  description  String
  amount       Decimal
  date         DateTime @default(now())
  orderId      String?
  payableId    String?
  receivableId String?
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())

  @@index([date])
  @@index([type])
}

/// Fechamento de DRE por período (snapshot calculado).
model FinancialResult {
  id                String   @id @default(cuid())
  periodType        String // DAY | WEEK | MONTH | YEAR | CUSTOM
  periodStart       DateTime
  periodEnd         DateTime
  grossRevenue      Decimal  @default(0)
  discounts         Decimal  @default(0)
  returns           Decimal  @default(0)
  netRevenue        Decimal  @default(0)
  cogs              Decimal  @default(0) // CMV
  grossProfit       Decimal  @default(0)
  operatingExpenses Decimal  @default(0)
  adminExpenses     Decimal  @default(0)
  salesExpenses     Decimal  @default(0)
  financialExpenses Decimal  @default(0)
  operatingResult   Decimal  @default(0)
  taxes             Decimal  @default(0)
  netProfit         Decimal  @default(0)
  createdAt         DateTime @default(now())

  @@unique([periodType, periodStart, periodEnd])
}

// ===========================================================================
// PROMOÇÕES / CUPONS
// ===========================================================================

model Promotion {
  id            String    @id @default(cuid())
  name          String
  scope         String // PRODUCT | CATEGORY
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id])
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  discountType  String // FIXED | PERCENT
  discountValue Decimal
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive])
}

model Coupon {
  id            String             @id @default(cuid())
  code          String             @unique
  type          String // FIXED | PERCENT
  value         Decimal
  minOrderValue Decimal?
  usageLimit    Int?
  usageCount    Int                @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean            @default(true)
  orders        Order[]
  redemptions   CouponRedemption[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model CouponRedemption {
  id         String    @id @default(cuid())
  couponId   String
  coupon     Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  usedAt     DateTime  @default(now())

  @@index([couponId])
}

// ===========================================================================
// CONFORMIDADE / CONTEÚDO
// ===========================================================================

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  subject     String?
  message     String
  status      String   @default("NEW") // NEW | IN_REVIEW | ANSWERED | CLOSED
  response    String?
  handledById String?
  handledBy   User?    @relation("ContactHandler", fields: [handledById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model CookieConsent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  sessionId String?
  necessary Boolean  @default(true)
  analytics Boolean  @default(false)
  marketing Boolean  @default(false)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([sessionId])
}

/// Trilha de auditoria (APPEND-ONLY).
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String // CREATE, UPDATE, DELETE, LOGIN, CANCEL, RETURN...
  entity      String // Product, Order, InventoryMovement...
  entityId    String?
  description String?
  /// JSON serializado (SQLite não tem tipo Json nativo no Prisma).
  metadata    String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}
